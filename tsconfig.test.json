{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "incremental": false,
    // Les tests tournent sous le « type stripping » natif de Node, qui résout
    // les imports en ESM : le chemin doit porter son extension `.ts`.
    "allowImportingTsExtensions": true,
    "types": ["node"]
  },
  "include": ["tests/**/*.ts", "src/**/*.ts"],
  "exclude": ["node_modules"]
}
