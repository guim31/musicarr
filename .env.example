# ─── Bibliothèque musicale ────────────────────────────────────────────────────
# Chemin du dossier musique monté dans le conteneur (voir docker-compose.yml).
# Développement local :
MUSIC_DIR=/home/utilisateur/Musique
# Production (NAS / Unraid) :
# MUSIC_DIR=/mnt/user/data/media/music

# ─── Base de données ──────────────────────────────────────────────────────────
# Chemin du fichier SQLite. Par défaut : <projet>/data/musicarr.db
# DB_PATH=/app/data/musicarr.db

# ─── Déploiement distant (deploy.sh) ──────────────────────────────────────────
# Renseignez ces valeurs pour utiliser ./deploy.sh
# NAS_USER=root
# NAS_HOST=192.168.1.10
# NAS_PATH=/mnt/user/appdata/musicarr

# ─── Note importante ──────────────────────────────────────────────────────────
# Les clés API (Prowlarr, SABnzbd, Discogs, ARL Deezer) ne se configurent PAS
# ici : elles sont saisies dans l'interface (page Réglages) et stockées dans la
# base SQLite, qui est ignorée par git. Ne committez jamais le dossier data/.
